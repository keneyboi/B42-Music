@rendermode InteractiveServer

<header class="sticky top-0 z-40 border-b border-void bg-paper">
    <div class="flex items-stretch justify-between">
        <a href="/" class="flex min-h-11 items-center px-4 headline text-xl hover:bg-void hover:text-paper">B42 Music</a>

        <nav class="hidden md:flex" aria-label="Primary">
            @foreach (var l in links)
            {
                <NavLink class="nav-link" href="@l.href" Match="@l.match">@l.label</NavLink>
            }
        </nav>

        <button class="btn m-1 min-w-11 md:hidden" aria-expanded="@open" aria-controls="drawer" aria-label="Open menu" @onclick="Toggle">
            <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2" /></svg>
        </button>
    </div>
</header>

@if (open)
{
    <div id="drawer" class="drawer fixed inset-0 z-50 flex flex-col bg-void text-paper" role="dialog" aria-modal="true" aria-label="Menu" @onkeydown="OnKey">
        <div class="flex items-center justify-between border-b border-paper/20 p-4">
            <span class="meta">Index</span>
            <button class="btn min-w-11" aria-label="Close menu" @onclick="Close">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2" /></svg>
            </button>
        </div>
        <nav class="flex flex-1 flex-col" aria-label="Mobile">
            @foreach (var l in links)
            {
                <NavLink class="headline flex min-h-11 flex-1 items-center border-b border-paper/20 px-4 text-5xl hover:bg-paper hover:text-void" href="@l.href" Match="@l.match" @onclick="Close">@l.label</NavLink>
            }
        </nav>
    </div>
}

@code {
    bool open;
    readonly (string href, string label, NavLinkMatch match)[] links =
    {
        ("/", "Archive", NavLinkMatch.All),
        ("items", "Catalog", NavLinkMatch.Prefix),
        ("roster", "Roster", NavLinkMatch.Prefix),
        ("contact", "Pre-Order", NavLinkMatch.Prefix),
    };

    void Toggle() => open = !open;
    void Close() => open = false;
    void OnKey(KeyboardEventArgs e) { if (e.Key == "Escape") open = false; }
}